{
  "name": "scaffold-typescript-cli",
  "version": "0.1.0",
  "private": true,
  "description": "A GitHub template for a TypeScript/bun CLI tool.",
  "scripts": {
    "format": "biome check --write .",
    "format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
    "lint": "biome check .",
    "lint:md": "markdownlint-cli2",
    "lint:mechanics": "./scripts/lint-mechanics.sh",
    "lint:prose": "./scripts/lint-prose.sh",
    "prepare": "lefthook install",
    "sort-package-json": "sort-package-json",
    "sort-package-json:check": "sort-package-json --check",
    "start": "bun run index.ts",
    "test": "bun test"
  },
  "dependencies": {
    "commander": "15.0.0",
    "cosmiconfig": "10.0.1",
    "env-paths": "4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/bun": "1.4.0",
    "lefthook": "2.1.10",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "sort-package-json": "4.0.0"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "lefthook"
  ]
}
